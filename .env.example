# Copy to .env and fill in real values. Never commit the real .env file.
#
# Local dev: the values below already match docker/centrifugo-config.json, so
# `docker compose up -d` + these defaults work together out of the box.
#
# Staging/production: generate real secrets instead of reusing these placeholders:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and set the same values in the deployed Centrifugo server's own config
# (http_api.key and client.token.hmac_secret_key).

# Address of the Centrifugo server.
CENTRIFUGO_API_URL=http://localhost:8888

# Server-side key for publish/broadcast calls. Must match Centrifugo's http_api.key.
CENTRIFUGO_API_KEY=dev-api-key-change-me

# Signs browser connection tokens. Must match Centrifugo's client.token.hmac_secret_key.
CENTRIFUGO_TOKEN_HMAC_SECRET=dev-hmac-secret-change-me-32-bytes-min

# Optional - all have defaults, uncomment to override.
# CENTRIFUGO_TOKEN_TTL_SECONDS=300
# CENTRIFUGO_TIMEOUT=5.0
# CENTRIFUGO_MAX_RETRIES=2
